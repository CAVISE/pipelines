{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "target": "ES2022",
    "skipLibCheck": true,
    "sourceMap": true,
    "noImplicitAny": false,
    "baseUrl": "./",
    "paths": {
      "@actions/smart-merge": ["actions/smart-merge/src"]
    },
    "useUnknownInCatchVariables": false
  },
  "exclude": ["node_modules", "**/*.test.ts", "**/__mocks__/*"]
}
