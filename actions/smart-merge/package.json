{
  "name": "@actions/smart-merge",
  "private": true,
  "description": "Action that performs merge with smart conflict resolution",
  "main": "dist/index.js",
  "scripts": {
    "audit-moderate": "npm audit --audit-level=moderate",
    "build": "npm run build:main && npm run build:driver",
    "build:main": "ncc build src/main.ts -o dist",
    "build:driver": "ncc build src/merge-driver.ts -o dist/merge-driver",
    "check": "tsc --noEmit",
    "tsc": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.8.3"
  }
}
