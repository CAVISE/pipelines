{
  "name": "root",
  "private": true,
  "description": "Root package for CAVISE actions",
  "scripts": {
    "audit-all": "lerna run audit-moderate",
    "bootstrap": "npm install",
    "build": "lerna run build",
    "check": "lerna run check",
    "clean": "lerna clean",
    "repair": "lerna repair",
    "format": "prettier --write \"actions/**/*.ts\"",
    "format-check": "prettier --check \"actions/**/*.ts\"",
    "lint": "eslint \"actions/**/*.ts\"",
    "lint-fix": "eslint \"actions/**/*.ts\" --fix",
    "test": "jest --testTimeout 70000",
    "typecheck": "lerna run tsc"
  },
  "scriptComments": {
    "audit-all": "Run the audit-moderate script (each package)",
    "bootstrap": "Install root packages (shared among actions)",
    "build": "Run the build (each package)",
    "check": "Run the check script (each package)",
    "clean": "Ask Lerna to remove package node_modules directories",
    "repair": "Run Lerna's repair routine for migrations",
    "format": "Format all TypeScript files",
    "format-check": "Verify formatting for all TypeScript files",
    "lint": "Lint all TypeScript files with ESLint",
    "lint-fix": "Lint all TypeScript files and apply auto-fixable changes",
    "test": "Run Jest tests with a 70-second timeout per test",
    "typecheck": "Run the typecheck script in every action package"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.1.0",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-prettier": "^5.2.6",
    "jest": "^29.7.0",
    "lerna": "^8.2.2",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.2",
    "typescript": "^5.8.3"
  }
}
